#3.0 proof:Formula f(x)=f(x0)+f'(x0)(x-x0)


import numpy as np
import matplotlib.pyplot as plt
import math
from sympy import symbols, diff, ln,log
from sympy.utilities.lambdify import lambdify

x0 = symbols('x')
f_x0 = ln(x0)
dy_x0 = diff(f_x0, x0)
x = symbols('x')
f_x = ln(x)
approx_f_x = f_x0 + dy_x0 * (x - x0)
x_vals = np.linspace(0.1,10,100)
approx_f_x_func = lambdify(x, approx_f_x, 'numpy')
approx_f_x_vals = [approx_f_x_func(val) for val in x_vals]
plt.plot(x_vals,approx_f_x_vals, label='Derivative Function')


#3.1.0 compare:Formula f(x)&f(x0)+f'(x0)(x-x0)


import numpy as np
import matplotlib.pyplot as plt
import math
from sympy import symbols, diff, ln,log
from sympy.utilities.lambdify import lambdify

x0 = symbols('x')
f_x0 = ln(x0)
dy_x0 = diff(f_x0, x0)
x = symbols('x')
f_x = ln(x)
approx_f_x = f_x0 + dy_x0 * (x - x0)
x_vals = np.linspace(0.1,10,100)
approx_f_x_func = lambdify(x, approx_f_x, 'numpy')
approx_f_x_vals = [approx_f_x_func(val) for val in x_vals]

f_x_func = lambdify(x, f_x, 'numpy')
f_x_vals = [f_x_func(val) for val in x_vals]


plt.plot(x_vals, f_x_vals, label='Original Function')

plt.plot(x_vals,approx_f_x_vals, label='Derivative Function')

plt.show()


